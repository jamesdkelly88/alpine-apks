pkgname=postgresql-pg_tle
pkgver=1.5.2
_pkgver="${pkgver}"
pkgrel=0
pkgdesc="Trusted Language Extensions for PostgreSQL"
url="https://github.com/aws/pg_tle"
arch="all"
license="Apache-2.0"
_pgver=18
makedepends="
	flex
	postgresql$_pgver
	postgresql$_pgver-dev
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/aws/pg_tle/archive/refs/tags/v$_pkgver.tar.gz"
builddir="$srcdir/pg_tle-$pkgver"

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

